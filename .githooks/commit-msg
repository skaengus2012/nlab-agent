#!/usr/bin/env bash
# Enforces the commit message convention in CONTRIBUTING.md:
#   Implement|Fix|Chore <#IssueNumber|N/A> - Description
set -u

msg_file="${1:-}"
if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
    echo "commit-msg: message file not found" >&2
    exit 1
fi

# Git's own comment lines are "#" or "# ...". A line such as "#bad subject" is content, not a comment,
# so it must not be skipped (git commit -m "#bad subject" would otherwise bypass the check).
max_subject_length=500

# The subject is the first line that is neither blank nor a comment.
subject=""
while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
        '#'|'# '*|'#'$'\t'*) continue ;;
    esac
    # Reject absurdly long lines before any per-character work on them.
    if [ "${#line}" -gt "$max_subject_length" ]; then
        echo "commit-msg: the subject is longer than $max_subject_length characters" >&2
        exit 1
    fi
    if [ -n "${line//[[:space:]]/}" ]; then
        subject="$line"
        break
    fi
done < "$msg_file"

if [ -z "$subject" ]; then
    echo "commit-msg: empty commit message" >&2
    exit 1
fi

# Subjects generated by git are not authored, so they are exempt. The patterns follow what git writes,
# so that arbitrary text starting with "Merge " or "Revert " is not exempt.
case "$subject" in
    "Merge branch "*|"Merge pull request "*|"Merge remote-tracking branch "*|"Merge tag "*|"Merge commit "*) exit 0 ;;
    'Revert "'*|'Reapply "'*) exit 0 ;;
    "fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

pattern='^(Implement|Fix|Chore) (#[0-9]+|N/A) - [^[:space:]].*$'
if [[ "$subject" =~ $pattern ]]; then
    exit 0
fi

cat >&2 <<MSG
commit-msg: the subject does not follow the repository convention.

  Subject : $subject
  Expected: Implement|Fix|Chore <#IssueNumber|N/A> - Description
  Example : Implement #12 - Add deep-research skill

See CONTRIBUTING.md.
MSG
exit 1
